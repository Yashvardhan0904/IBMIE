{
  "version": 1,
  "description": "Configurable reference ranges. Values are intentionally conservative adult defaults and must be overridden per laboratory where possible.",
  "analytes": {
    "blood_pressure": {
      "unit": "mmHg",
      "systolic": { "low": 90, "high": 120 },
      "diastolic": { "low": 60, "high": 80 }
    },
    "temperature": {
      "unit": "°C",
      "low": 36.1,
      "high": 37.2
    },
    "pulse": {
      "unit": "beats/min",
      "low": 60,
      "high": 100
    },
    "respiratory_rate": {
      "unit": "breaths/min",
      "low": 12,
      "high": 20
    },
    "spo2": {
      "unit": "%",
      "low": 95,
      "high": 100
    },
    "hemoglobin": {
      "unit": "g/dL",
      "by_gender": {
        "male": { "low": 13.0, "high": 17.0 },
        "female": { "low": 12.0, "high": 15.5 },
        "other": { "low": 12.0, "high": 17.0 }
      },
      "age_bands": [
        {
          "min_age": 65,
          "max_age": 130,
          "low": 12.0,
          "high": 17.0
        }
      ],
      "default": { "low": 12.0, "high": 17.0 }
    },
    "wbc": {
      "unit": "cells/µL",
      "low": 4000,
      "high": 11000
    },
    "neutrophils": {
      "unit": "%",
      "low": 40,
      "high": 75
    },
    "crp": {
      "unit": "mg/L",
      "high": 5
    },
    "fasting_glucose": {
      "unit": "mg/dL",
      "low": 70,
      "high": 99
    },
    "post_prandial_glucose": {
      "unit": "mg/dL",
      "high": 140
    },
    "random_glucose": {
      "unit": "mg/dL",
      "low": 70,
      "high": 140
    },
    "hba1c": {
      "unit": "%",
      "low": 4.0,
      "high": 5.6
    }
  }
}
